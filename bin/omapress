#!/usr/bin/env python3
"""Helper for the Omapress shell plugin.

Fetches an RSS/Atom feed (the Omarchy news feed by default), converts each
post into plain-text blocks the panel can render, keeps track of which posts
have been read, and prints a single JSON document on stdout.

Standard library only; no third-party modules.

    omapress [--budget SEC] [--own-process-group] fetch [--url URL] [--max N]
             [--offline] [--source FILE]
    omapress mark-read ID...
    omapress mark-unread ID...
    omapress mark-all-read

Network policy: the feed URL and every redirect hop must be https, carry no
credentials, use the default port, and name a public host. Bodies are read
in bounded chunks under a byte cap. Every run has one absolute deadline
(--budget) that every socket operation inherits as remaining time.

State lives in $XDG_STATE_HOME/omapress (read/known post ids); the last good
feed is cached in $XDG_CACHE_HOME/omapress so the panel has something to show
while offline. Both can be redirected with OMAPRESS_STATE_DIR and
OMAPRESS_CACHE_DIR, which the tests use. Each directory is claimed by a held
descriptor, must be ours and 0700, and is read and written only relative to
that descriptor: no symlink is followed, files must be regular and singly
linked, and writes are exclusive temp files renamed into place.
"""

import argparse
import email.utils
import errno
import ipaddress
import json
import os
import re
import secrets
import signal
import stat
import socket
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
from html.parser import HTMLParser
from xml.etree import ElementTree as ET

SCHEMA_VERSION = 1
DEFAULT_URL = "https://omarchy.org/news/rss.xml"
DEFAULT_MAX_ITEMS = 30

# ---------------------------------------------------------------- output caps
#
# Everything the helper prints is bounded by these, and the payload budget is
# derived from them rather than chosen beside them, so a run cannot emit past
# the ceiling the QML side enforces (Model.js MAX_PAYLOAD_CHARS). emit()
# checks the serialised size against the budget as a final guard.
MAX_ITEMS = 50
MAX_ID_CHARS = 2048
MAX_TITLE_CHARS = 300
MAX_AUTHOR_CHARS = 120
MAX_SUMMARY_CHARS = 400
MAX_BLOCKS_PER_ITEM = 200
MAX_BLOCK_CHARS = 4000
MAX_BODY_CHARS = 30000          # all blocks of one post together
MAX_LINKS_PER_ITEM = 30
MAX_LINK_TEXT_CHARS = 200
MAX_FEED_TITLE_CHARS = 200
MAX_FEED_DESC_CHARS = 400
MAX_MESSAGE_CHARS = 300
MAX_MARK_IDS = 50               # ids one mark command accepts
MAX_STATE_IDS = 500             # read/known ids kept per list
JSON_OVERHEAD_FACTOR = 1.25     # keys, quotes, escapes
_ITEM_WORST = (MAX_ID_CHARS + MAX_TITLE_CHARS + MAX_ID_CHARS + MAX_AUTHOR_CHARS
               + MAX_SUMMARY_CHARS + MAX_BODY_CHARS
               + MAX_LINKS_PER_ITEM * (MAX_LINK_TEXT_CHARS + MAX_ID_CHARS))
MAX_PAYLOAD_CHARS = 8 * 1024 * 1024
assert int(MAX_ITEMS * _ITEM_WORST * JSON_OVERHEAD_FACTOR) + 64 * 1024 < MAX_PAYLOAD_CHARS
MAX_STATE_BYTES = 512 * 1024
MAX_CACHE_BYTES = MAX_PAYLOAD_CHARS
DEFAULT_BUDGET = 30.0
MIN_BUDGET = 5.0
MAX_BUDGET = 600.0
# One request's socket timeout, capped by what is left of the budget.
REQUEST_TIMEOUT = 15.0
# The feed body, on the wire and on disk. omarchy.org's feed is ~50 KiB.
MAX_FEED_BYTES = 4 * 1024 * 1024
READ_CHUNK = 64 * 1024
MAX_REDIRECTS = 5
MAX_URL_CHARS = 2048
# On the very first run everything older than this is marked read, so a fresh
# install shows what's new rather than lighting up for the whole archive.
FIRST_RUN_UNREAD_DAYS = 14
USER_AGENT = "omapress/0.2 (+https://github.com/renerocksai/omapress)"

NS_CONTENT = "{http://purl.org/rss/1.0/modules/content/}"
NS_DC = "{http://purl.org/dc/elements/1.1/}"
NS_ATOM = "{http://www.w3.org/2005/Atom}"


# ------------------------------------------------------------------ deadline

DEADLINE = float("inf")


class Timeout(Exception):
    """The run's absolute budget is spent."""


class Terminated(Exception):
    """SIGTERM arrived; unwind so `finally` blocks run."""


def remaining():
    return DEADLINE - time.monotonic()


def net_timeout(cap=REQUEST_TIMEOUT):
    left = remaining()
    if left <= 0:
        raise Timeout()
    return max(0.1, min(cap, left))


def on_alarm(signum, frame):
    raise Timeout()


def on_terminate(signum, frame):
    raise Terminated()


# ---------------------------------------------------------------- url policy

class UrlError(ValueError):
    pass


_HOSTNAME_RE = re.compile(r"^(?=.{1,253}$)([a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)(\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)*$")
_BLOCKED_SUFFIXES = (".localhost", ".local", ".internal", ".home.arpa", ".lan")


def _is_public_address(address):
    try:
        ip = ipaddress.ip_address(address)
    except ValueError:
        return False
    return not (ip.is_private or ip.is_loopback or ip.is_link_local or ip.is_multicast
                or ip.is_reserved or ip.is_unspecified)


def _resolves_publicly(host):
    """Every address the host resolves to must be public. Resolution failures
    are left to the request itself so the error message stays meaningful."""
    try:
        infos = socket.getaddrinfo(host, 443, type=socket.SOCK_STREAM)
    except socket.gaierror:
        return True
    for info in infos:
        if not _is_public_address(info[4][0]):
            return False
    return True


def check_url(url, allow_http=False, resolve=True):
    """Return the URL if it may be requested or opened; raise UrlError if not.

    Rules: https (http too only where the caller says so), a hostname rather
    than an IP literal, no credentials, no explicit port, no whitespace or
    control characters, a length cap, and no local or private destination.
    """
    value = str(url or "")
    if not value or len(value) > MAX_URL_CHARS:
        raise UrlError("URL is empty or too long")
    if any(ord(ch) < 0x20 or ord(ch) == 0x7F or ch.isspace() for ch in value):
        raise UrlError("URL contains whitespace or control characters")
    parts = urllib.parse.urlsplit(value)
    scheme = parts.scheme.lower()
    if scheme != "https" and not (allow_http and scheme == "http"):
        raise UrlError("URL must use https")
    if parts.username is not None or parts.password is not None or "@" in parts.netloc:
        raise UrlError("URL must not carry credentials")
    try:
        port = parts.port
    except ValueError:
        raise UrlError("URL has an invalid port")
    if port is not None:
        raise UrlError("URL must use the default port")
    host = (parts.hostname or "").lower().rstrip(".")
    if not host:
        raise UrlError("URL has no host")
    if host == "localhost" or host.endswith(_BLOCKED_SUFFIXES):
        raise UrlError("URL points at a local host")
    if parts.netloc.startswith("[") or _looks_like_ip(host):
        raise UrlError("URL must name a host, not an address")
    if not _HOSTNAME_RE.match(host) or "." not in host:
        raise UrlError("URL host is not a valid public hostname")
    if resolve and not _resolves_publicly(host):
        raise UrlError("URL host resolves to a private address")
    return value


def safe_link(url):
    """A link the panel may show and open: http or https under the same
    host rules as the feed, minus the DNS check, which would cost one
    resolution per link at parse time. Anything else becomes ""."""
    try:
        return check_url(url, allow_http=True, resolve=False)
    except UrlError:
        return ""


def _looks_like_ip(host):
    try:
        ipaddress.ip_address(host)
        return True
    except ValueError:
        return bool(re.match(r"^[0-9.]+$", host)) or bool(re.match(r"^0x[0-9a-f]+$", host))


class PolicyRedirectHandler(urllib.request.HTTPRedirectHandler):
    """Re-validates every hop against the same policy as the first request
    and caps the chain length."""

    def __init__(self):
        super().__init__()
        self.hops = 0

    def redirect_request(self, req, fp, code, msg, headers, newurl):
        self.hops += 1
        if self.hops > MAX_REDIRECTS:
            raise urllib.error.HTTPError(req.full_url, code, "too many redirects", headers, fp)
        try:
            check_url(newurl)
        except UrlError as error:
            raise urllib.error.HTTPError(req.full_url, code, "redirect refused: %s" % error, headers, fp)
        new = super().redirect_request(req, fp, code, msg, headers, newurl)
        if new is not None:
            new.timeout = net_timeout()
        return new


class BodyTooLarge(Exception):
    pass


def read_bounded(stream, limit):
    """Read at most `limit` bytes; one byte more is an error, not a truncation."""
    chunks = []
    total = 0
    while True:
        chunk = stream.read(min(READ_CHUNK, limit - total + 1))
        if not chunk:
            break
        total += len(chunk)
        if total > limit:
            raise BodyTooLarge()
        chunks.append(chunk)
        if remaining() <= 0:
            raise Timeout()
    return b"".join(chunks)


# ----------------------------------------------------------------- text caps

_CONTROL_RE = re.compile(r"[\x00-\x08\x0b\x0c\x0e-\x1f\x7f-\x9f]")


def clean_text(value, limit, keep_newlines=False):
    """Control characters out, whitespace normalised, clipped to `limit`."""
    text = _CONTROL_RE.sub("", str(value or ""))
    if keep_newlines:
        lines = [re.sub(r"[ \t\r\f\v]+", " ", line).strip() for line in text.split("\n")]
        text = "\n".join(line for line in lines if line != "")
    else:
        text = re.sub(r"\s+", " ", text).strip()
    if len(text) > limit:
        text = text[: max(0, limit - 1)].rstrip() + "…"
    return text


def clean_id(value, limit=MAX_ID_CHARS):
    """An id is opaque: no whitespace or control characters, length-capped,
    and never clipped (a clipped id would silently alias another)."""
    text = str(value or "")
    if text == "" or len(text) > limit or any(ord(ch) < 0x20 or ord(ch) == 0x7F or ch.isspace() for ch in text):
        return ""
    return text


# --------------------------------------------------------------------- paths

def _xdg(env, fallback):
    base = os.environ.get(env)
    if not base:
        base = os.path.join(os.path.expanduser("~"), fallback)
    return base


def state_dir():
    return os.environ.get("OMAPRESS_STATE_DIR") or os.path.join(_xdg("XDG_STATE_HOME", ".local/state"), "omapress")


def cache_dir():
    return os.environ.get("OMAPRESS_CACHE_DIR") or os.path.join(_xdg("XDG_CACHE_HOME", ".cache"), "omapress")


class StateError(Exception):
    """The private directory cannot be used safely."""


class PrivateDir:
    """A directory we own, held open by descriptor so every read and write is
    relative to the directory we checked rather than to a path that could be
    re-pointed underneath us.

    Reads accept only an owned, regular, singly-linked file under a byte cap,
    opened without following symlinks. Writes go to a random-named O_EXCL 0600
    temp file, fsync, then rename over the entry, which replaces a planted
    symlink rather than following it.
    """

    def __init__(self, path):
        self.path = path
        try:
            os.makedirs(path, mode=0o700, exist_ok=True)
            self.fd = os.open(path, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC)
        except OSError as error:
            # O_DIRECTORY|O_NOFOLLOW on a symlink reports ENOTDIR on Linux.
            if error.errno in (errno.ELOOP, errno.ENOTDIR) and os.path.islink(path):
                raise StateError("%s is a symlink" % path)
            raise StateError("%s: %s" % (path, error.strerror))
        info = os.fstat(self.fd)
        if info.st_uid != os.getuid():
            os.close(self.fd)
            raise StateError("%s is not owned by this user" % path)
        if info.st_mode & 0o077:
            os.fchmod(self.fd, 0o700)

    def read(self, name, limit):
        """The file's bytes, or None when it is absent or not ours to trust."""
        try:
            fd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC, dir_fd=self.fd)
        except FileNotFoundError:
            return None
        except OSError as error:
            if error.errno in (errno.ELOOP, errno.ENXIO):
                return None
            raise
        try:
            info = os.fstat(fd)
            if not stat.S_ISREG(info.st_mode) or info.st_nlink != 1 or info.st_uid != os.getuid() or info.st_size > limit:
                return None
            with os.fdopen(fd, "rb") as handle:
                fd = -1
                return read_bounded(handle, limit)
        except BodyTooLarge:
            return None
        finally:
            if fd >= 0:
                os.close(fd)

    def write(self, name, data):
        tmp = ".%s.%s.tmp" % (name, secrets.token_hex(8))
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600, dir_fd=self.fd)
        try:
            with os.fdopen(fd, "wb") as handle:
                fd = -1
                handle.write(data)
                handle.flush()
                os.fsync(handle.fileno())
            os.rename(tmp, name, src_dir_fd=self.fd, dst_dir_fd=self.fd)
            os.fsync(self.fd)
        except BaseException:
            if fd >= 0:
                os.close(fd)
            try:
                os.unlink(tmp, dir_fd=self.fd)
            except OSError:
                pass
            raise

    def sweep(self):
        """Drop temp files an interrupted earlier run may have left behind."""
        try:
            names = os.listdir(self.fd)
        except OSError:
            return
        for name in names[:1000]:
            if name.startswith(".") and name.endswith(".tmp"):
                try:
                    os.unlink(name, dir_fd=self.fd)
                except OSError:
                    pass


_STORES = {}


def store(kind):
    if kind not in _STORES:
        _STORES[kind] = PrivateDir(state_dir() if kind == "state" else cache_dir())
        _STORES[kind].sweep()
    return _STORES[kind]


def read_json(kind, name, fallback, limit):
    """A dict from a JSON file in the private store, else fallback."""
    raw = store(kind).read(name, limit)
    if raw is None:
        return fallback
    try:
        data = json.loads(raw.decode("utf-8"))
    except (ValueError, UnicodeDecodeError):
        return fallback
    return data if isinstance(data, dict) else fallback


def write_json(kind, name, data):
    store(kind).write(name, json.dumps(data, ensure_ascii=False, separators=(",", ":")).encode("utf-8"))


# --------------------------------------------------------------- html → text

class BlockParser(HTMLParser):
    """Flattens post HTML into a list of {kind, text} blocks plus the links.

    kinds: p, heading, item, quote, code. Inline markup is dropped; block
    boundaries become separate blocks; <br> becomes a newline inside a block.
    """

    BLOCK_TAGS = {
        "p", "div", "section", "article", "header", "footer", "aside", "main",
        "ul", "ol", "li", "dl", "dt", "dd", "table", "tr", "figure", "figcaption",
        "blockquote", "pre", "hr", "h1", "h2", "h3", "h4", "h5", "h6",
    }
    SKIP_TAGS = {"script", "style", "noscript", "template", "svg", "iframe"}

    def __init__(self):
        super().__init__(convert_charrefs=True)
        self.blocks = []
        self.links = []
        self._seen_links = set()
        self._buf = []
        self._buf_chars = 0
        self._body_chars = 0
        self._stack = []
        self._skip = 0
        self._link_text = None
        self._link_href = ""

    @property
    def full(self):
        return len(self.blocks) >= MAX_BLOCKS_PER_ITEM or self._body_chars >= MAX_BODY_CHARS

    # ---- helpers
    def _kind(self):
        if "pre" in self._stack:
            return "code"
        for tag in reversed(self._stack):
            if tag in ("h1", "h2", "h3", "h4", "h5", "h6"):
                return "heading"
            if tag == "li":
                return "item"
            if tag == "blockquote":
                return "quote"
        return "p"

    def _flush(self):
        text = "".join(self._buf)
        self._buf = []
        self._buf_chars = 0
        if self.full:
            return
        kind = self._kind()
        if kind == "code":
            text = _CONTROL_RE.sub("", text).strip("\n")
            if text.strip() == "":
                return
            if len(text) > MAX_BLOCK_CHARS:
                text = text[: MAX_BLOCK_CHARS - 1] + "…"
        else:
            text = clean_text(text, MAX_BLOCK_CHARS, keep_newlines=True)
            if text == "":
                return
        room = MAX_BODY_CHARS - self._body_chars
        if len(text) > room:
            text = text[: max(0, room - 1)].rstrip() + "…"
        self._body_chars += len(text)
        self.blocks.append({"kind": kind, "text": text})

    def _append(self, data):
        # Past the per-block cap the text is going to be clipped anyway, so
        # stop buffering it: a single enormous text node must not grow memory.
        if self._buf_chars >= MAX_BLOCK_CHARS + 16:
            return
        self._buf.append(data)
        self._buf_chars += len(data)

    # ---- parser callbacks
    def handle_starttag(self, tag, attrs):
        if tag in self.SKIP_TAGS:
            self._skip += 1
            return
        if self._skip:
            return
        if tag in self.BLOCK_TAGS:
            self._flush()
            if tag != "hr":
                self._stack.append(tag)
            return
        if tag == "br":
            self._append("\n")
            return
        if tag == "a":
            href = ""
            for name, value in attrs:
                if name == "href" and value:
                    href = value.strip()
            self._link_text = []
            self._link_href = href
            return
        if tag == "img":
            alt = ""
            for name, value in attrs:
                if name == "alt" and value:
                    alt = value.strip()
            if alt:
                self._append("[" + clean_text(alt, MAX_LINK_TEXT_CHARS) + "]")

    def handle_startendtag(self, tag, attrs):
        self.handle_starttag(tag, attrs)
        if tag not in self.BLOCK_TAGS and tag not in ("br", "a", "img"):
            return
        if tag == "a":
            self.handle_endtag(tag)

    def handle_endtag(self, tag):
        if tag in self.SKIP_TAGS:
            self._skip = max(0, self._skip - 1)
            return
        if self._skip:
            return
        if tag in self.BLOCK_TAGS:
            self._flush()
            if tag in self._stack:
                while self._stack:
                    popped = self._stack.pop()
                    if popped == tag:
                        break
            return
        if tag == "a":
            text = "".join(self._link_text or []).strip()
            href = self._link_href
            self._link_text = None
            self._link_href = ""
            if len(self.links) >= MAX_LINKS_PER_ITEM:
                return
            href = safe_link(href)
            if href:
                key = href.rstrip("/")
                if key not in self._seen_links:
                    self._seen_links.add(key)
                    self.links.append({"text": clean_text(text, MAX_LINK_TEXT_CHARS) or href, "href": href})

    def handle_data(self, data):
        if self._skip or self.full:
            return
        self._append(data)
        if self._link_text is not None and sum(len(part) for part in self._link_text) < MAX_LINK_TEXT_CHARS + 16:
            self._link_text.append(data)

    def close(self):
        super().close()
        self._flush()
        self._stack = []


def html_to_blocks(markup):
    parser = BlockParser()
    try:
        parser.feed(markup or "")
        parser.close()
    except Exception:  # noqa: BLE001 - never let a weird post kill the feed
        text = clean_text(re.sub(r"<[^>]+>", " ", markup or ""), MAX_BLOCK_CHARS)
        return ([{"kind": "p", "text": text}] if text else []), []
    return parser.blocks, parser.links


def html_to_text(markup):
    blocks, _ = html_to_blocks(markup)
    return " ".join(block["text"].replace("\n", " ") for block in blocks).strip()


def summarize(text, limit=220):
    text = clean_text(text, MAX_SUMMARY_CHARS * 4)
    if len(text) <= limit:
        return text
    cut = text[:limit]
    space = cut.rfind(" ")
    if space > limit * 0.6:
        cut = cut[:space]
    return cut.rstrip(" ,;:") + "…"


# ----------------------------------------------------------------- feed parse

def _text(node, *paths):
    for path in paths:
        found = node.find(path)
        if found is not None and found.text:
            return found.text.strip()
    return ""


def _parse_date(value):
    value = (value or "").strip()
    if not value:
        return 0
    try:
        parsed = email.utils.parsedate_to_datetime(value)
        if parsed is not None:
            return int(parsed.timestamp())
    except (TypeError, ValueError, IndexError):
        pass
    # ISO 8601 (Atom). Python's fromisoformat handles the common shapes.
    try:
        from datetime import datetime, timezone
        iso = value.replace("Z", "+00:00")
        parsed = datetime.fromisoformat(iso)
        if parsed.tzinfo is None:
            parsed = parsed.replace(tzinfo=timezone.utc)
        return int(parsed.timestamp())
    except ValueError:
        return 0


def _build_item(item_id, title, link, author, published_ts, summary_html, body_html):
    item_id = clean_id(item_id)
    if not item_id:
        return None
    blocks, links = html_to_blocks(body_html or summary_html)
    summary = summarize(html_to_text(summary_html) or (blocks[0]["text"] if blocks else ""))
    return {
        "id": item_id,
        "title": clean_text(title, MAX_TITLE_CHARS) or "Untitled",
        "link": safe_link(str(link or "").strip()),
        "author": clean_text(author, MAX_AUTHOR_CHARS),
        "publishedTs": max(0, min(4102444800, int(published_ts or 0))),
        "summary": clean_text(summary, MAX_SUMMARY_CHARS),
        "blocks": blocks[:MAX_BLOCKS_PER_ITEM],
        "links": links[:MAX_LINKS_PER_ITEM],
    }


def _feed_info(title, link, description):
    return {
        "title": clean_text(title, MAX_FEED_TITLE_CHARS),
        "link": safe_link(str(link or "").strip()),
        "description": clean_text(description, MAX_FEED_DESC_CHARS),
    }


def parse_rss_channel(channel):
    feed = _feed_info(_text(channel, "title"), _text(channel, "link"), _text(channel, "description"))
    items = []
    for node in channel.findall("item"):
        if len(items) >= MAX_ITEMS * 4:
            break
        link = _text(node, "link")
        guid = _text(node, "guid") or link
        if not guid:
            continue
        title = _text(node, "title")
        author = _text(node, NS_DC + "creator", "author")
        published = _parse_date(_text(node, "pubDate", NS_DC + "date"))
        description = _text(node, "description")
        content = _text(node, NS_CONTENT + "encoded")
        item = _build_item(guid, title, link, author, published, description, content)
        if item is not None:
            items.append(item)
    return feed, items


def parse_atom(root):
    feed_link = ""
    for link in root.findall(NS_ATOM + "link"):
        if link.get("rel", "alternate") == "alternate" and link.get("href"):
            feed_link = link.get("href")
            break
    feed = _feed_info(_text(root, NS_ATOM + "title"), feed_link, _text(root, NS_ATOM + "subtitle"))
    items = []
    for entry in root.findall(NS_ATOM + "entry"):
        if len(items) >= MAX_ITEMS * 4:
            break
        link = ""
        for candidate in entry.findall(NS_ATOM + "link"):
            if candidate.get("rel", "alternate") == "alternate" and candidate.get("href"):
                link = candidate.get("href")
                break
        entry_id = _text(entry, NS_ATOM + "id") or link
        if not entry_id:
            continue
        title = _text(entry, NS_ATOM + "title")
        author = _text(entry, NS_ATOM + "author/" + NS_ATOM + "name")
        published = _parse_date(_text(entry, NS_ATOM + "published", NS_ATOM + "updated"))
        summary = _text(entry, NS_ATOM + "summary")
        content = _text(entry, NS_ATOM + "content")
        item = _build_item(entry_id, title, link, author, published, summary, content)
        if item is not None:
            items.append(item)
    return feed, items


class FeedRejected(Exception):
    pass


_DTD_RE = re.compile(rb"<!\s*(DOCTYPE|ENTITY)", re.IGNORECASE)


def parse_feed(payload):
    # A feed never needs a DTD; the only thing one can do here is entity
    # expansion, which the stdlib parser does not bound.
    if _DTD_RE.search(payload):
        raise FeedRejected("Feed carries a DTD")
    root = ET.fromstring(payload)
    if root.tag == NS_ATOM + "feed":
        return parse_atom(root)
    channel = root.find("channel")
    if channel is None:
        # RSS 1.0 / RDF puts items next to the channel rather than inside it.
        channel = root
    return parse_rss_channel(channel)


# ---------------------------------------------------------------------- fetch

def fetch_url(url, etag, last_modified):
    """Returns (status, body_bytes, headers). status is 200 or 304, or raises.

    The URL has already passed check_url. The body is streamed under
    MAX_FEED_BYTES, and a declared Content-Length above it is refused before
    a byte is read.
    """
    headers = {
        "User-Agent": USER_AGENT,
        "Accept": "application/rss+xml, application/atom+xml, application/xml, text/xml;q=0.9, */*;q=0.5",
        "Accept-Encoding": "identity",
    }
    if etag:
        headers["If-None-Match"] = etag
    if last_modified:
        headers["If-Modified-Since"] = last_modified
    opener = urllib.request.build_opener(PolicyRedirectHandler())
    request = urllib.request.Request(url, headers=headers)
    try:
        with opener.open(request, timeout=net_timeout()) as response:
            declared = response.headers.get("Content-Length")
            if declared is not None:
                try:
                    if int(declared) > MAX_FEED_BYTES:
                        raise BodyTooLarge()
                except ValueError:
                    pass
            body = read_bounded(response, MAX_FEED_BYTES)
            return 200, body, dict(response.headers)
    except urllib.error.HTTPError as error:
        if error.code == 304:
            return 304, b"", dict(error.headers or {})
        raise


def read_source_file(path):
    """A local feed for tests and offline debugging: a regular file under the
    same byte cap, opened without following symlinks."""
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC)
    except OSError as error:
        if error.errno == errno.ELOOP:
            raise UrlError("source is not a regular file")
        raise
    try:
        info = os.fstat(fd)
        if not _is_regular(info):
            raise UrlError("source is not a regular file")
        if info.st_size > MAX_FEED_BYTES:
            raise BodyTooLarge()
        with os.fdopen(fd, "rb") as handle:
            fd = -1
            return read_bounded(handle, MAX_FEED_BYTES)
    finally:
        if fd >= 0:
            os.close(fd)


def _is_regular(info):
    import stat
    return stat.S_ISREG(info.st_mode)


def describe_error(error):
    if isinstance(error, UrlError):
        return "Feed URL refused: %s" % error
    if isinstance(error, FeedRejected):
        return str(error)
    if isinstance(error, BodyTooLarge):
        return "Feed is larger than %d MiB" % (MAX_FEED_BYTES // (1024 * 1024))
    if isinstance(error, Timeout):
        return "Feed fetch ran out of time"
    if isinstance(error, urllib.error.HTTPError):
        if error.code in (301, 302, 303, 307, 308) and "refused" in str(error.reason):
            return "Feed %s" % error.reason
        return "Feed returned HTTP %d" % error.code
    if isinstance(error, urllib.error.URLError):
        reason = getattr(error, "reason", None)
        return "Could not reach the feed (%s)" % (reason if reason else "network error")
    if isinstance(error, ET.ParseError):
        return "Feed is not valid XML (%s)" % error
    if isinstance(error, (TimeoutError, socket.timeout)):
        return "Feed timed out"
    return str(error) or error.__class__.__name__


# ---------------------------------------------------------------------- state

def _id_list(value, limit):
    if not isinstance(value, list):
        return []
    out = []
    for entry in value[-limit * 2:]:
        if isinstance(entry, str):
            cleaned = clean_id(entry)
            if cleaned:
                out.append(cleaned)
    return out[-limit:]


def load_state():
    state = read_json("state", "state.json", {}, MAX_STATE_BYTES)
    return {
        "schemaVersion": SCHEMA_VERSION,
        "read": _id_list(state.get("read"), MAX_STATE_IDS),
        "known": _id_list(state.get("known"), MAX_STATE_IDS),
        "initialized": bool(state.get("initialized", False)),
    }


def save_state(state, item_ids):
    # Keep ids that are still in the feed plus a tail of recent history, so a
    # post that briefly drops out of the feed does not come back as unread.
    keep = set(item_ids)

    def prune(values):
        kept = [value for value in values if value in keep]
        tail = [value for value in values if value not in keep]
        return (kept + tail[-(MAX_STATE_IDS - len(kept)):])[:MAX_STATE_IDS] if len(kept) < MAX_STATE_IDS else kept[:MAX_STATE_IDS]

    write_json("state", "state.json", {
        "schemaVersion": SCHEMA_VERSION,
        "read": prune(state["read"]),
        "known": prune(state["known"]),
        "initialized": True,
    })


def coerce_block(value):
    if not isinstance(value, dict):
        return None
    kind = value.get("kind")
    if kind not in ("p", "heading", "item", "quote", "code"):
        kind = "p"
    text = value.get("text")
    if not isinstance(text, str):
        return None
    text = _CONTROL_RE.sub("", text)
    if len(text) > MAX_BLOCK_CHARS:
        text = text[: MAX_BLOCK_CHARS - 1] + "…"
    return {"kind": kind, "text": text} if text.strip() else None


def coerce_link(value):
    if not isinstance(value, dict) or not isinstance(value.get("href"), str):
        return None
    href = safe_link(value["href"].strip())
    if not href:
        return None
    return {"text": clean_text(value.get("text"), MAX_LINK_TEXT_CHARS) or href, "href": href}


def coerce_item(value):
    """A cached item is re-read through the same closed shape a parsed one
    has, so a tampered or stale cache cannot widen what reaches the panel."""
    if not isinstance(value, dict):
        return None
    item_id = clean_id(value.get("id"))
    if not item_id:
        return None
    blocks = []
    body = 0
    for block in (value.get("blocks") if isinstance(value.get("blocks"), list) else [])[:MAX_BLOCKS_PER_ITEM]:
        coerced = coerce_block(block)
        if coerced is None:
            continue
        room = MAX_BODY_CHARS - body
        if room <= 0:
            break
        if len(coerced["text"]) > room:
            coerced["text"] = coerced["text"][: max(0, room - 1)] + "…"
        body += len(coerced["text"])
        blocks.append(coerced)
    links = [link for link in (coerce_link(entry) for entry in (value.get("links") if isinstance(value.get("links"), list) else [])[:MAX_LINKS_PER_ITEM]) if link]
    link = safe_link(value.get("link").strip()) if isinstance(value.get("link"), str) else ""
    try:
        published = int(value.get("publishedTs") or 0)
    except (TypeError, ValueError):
        published = 0
    return {
        "id": item_id,
        "title": clean_text(value.get("title"), MAX_TITLE_CHARS) or "Untitled",
        "link": link,
        "author": clean_text(value.get("author"), MAX_AUTHOR_CHARS),
        "publishedTs": max(0, min(4102444800, published)),
        "summary": clean_text(value.get("summary"), MAX_SUMMARY_CHARS),
        "blocks": blocks,
        "links": links,
    }


def coerce_cache(value):
    if not isinstance(value, dict) or not isinstance(value.get("items"), list):
        return None
    items = []
    seen = set()
    for entry in value["items"]:
        if len(items) >= MAX_ITEMS:
            break
        item = coerce_item(entry)
        if item is not None and item["id"] not in seen:
            seen.add(item["id"])
            items.append(item)
    feed = value.get("feed") if isinstance(value.get("feed"), dict) else {}
    try:
        fetched = int(value.get("fetchedTs") or 0)
    except (TypeError, ValueError):
        fetched = 0
    url = value.get("url") if isinstance(value.get("url"), str) else ""
    etag = value.get("etag") if isinstance(value.get("etag"), str) else ""
    last_modified = value.get("lastModified") if isinstance(value.get("lastModified"), str) else ""
    return {
        "schemaVersion": SCHEMA_VERSION,
        "url": url if len(url) <= MAX_URL_CHARS else "",
        "fetchedTs": max(0, fetched),
        "etag": clean_text(etag, 256),
        "lastModified": clean_text(last_modified, 64),
        "feed": _feed_info(feed.get("title"), feed.get("link"), feed.get("description")),
        "items": items,
    }


def load_cache():
    return coerce_cache(read_json("cache", "feed.json", {}, MAX_CACHE_BYTES))


def emit(payload):
    if isinstance(payload.get("message"), str):
        payload["message"] = clean_text(payload["message"], MAX_MESSAGE_CHARS)
    text = json.dumps(payload, ensure_ascii=False)
    if len(text) > MAX_PAYLOAD_CHARS:
        # Cannot happen by construction (see the caps above); refuse rather
        # than hand the shell something larger than it will accept.
        text = json.dumps(error_payload("Feed payload exceeds the output budget", str(payload.get("url", "")), int(time.time())))
    sys.stdout.write(text)
    sys.stdout.write("\n")


def build_payload(state, cache, source, message, new_ids, now):
    read = set(state["read"])
    items = []
    for item in cache.get("items", []):
        entry = dict(item)
        entry["read"] = entry["id"] in read
        items.append(entry)
    unread = sum(1 for item in items if not item["read"])
    return {
        "schemaVersion": SCHEMA_VERSION,
        "state": "ready",
        "message": message,
        "source": source,
        "url": cache.get("url", ""),
        "fetchedTs": int(cache.get("fetchedTs", 0)),
        "generatedTs": now,
        "feed": cache.get("feed", {}),
        "items": items,
        "unread": unread,
        "newIds": new_ids[:MAX_ITEMS],
    }


def error_payload(message, url, now):
    return {
        "schemaVersion": SCHEMA_VERSION,
        "state": "error",
        "message": message,
        "source": "none",
        "url": url,
        "fetchedTs": 0,
        "generatedTs": now,
        "feed": {},
        "items": [],
        "unread": 0,
        "newIds": [],
    }


# ------------------------------------------------------------------- commands

def cmd_fetch(args):
    now = int(time.time())
    try:
        check_url(args.url, resolve=not args.offline and not args.source)
    except UrlError as error:
        emit(error_payload(describe_error(error), args.url, now))
        return 1
    state = load_state()
    cache = load_cache()
    cache_matches = cache is not None and cache.get("url") == args.url
    message = ""
    source = "cache"

    if not args.offline:
        etag = cache.get("etag", "") if cache_matches else ""
        last_modified = cache.get("lastModified", "") if cache_matches else ""
        try:
            if args.source:
                status, body, headers = 200, read_source_file(args.source), {}
            else:
                status, body, headers = fetch_url(args.url, etag, last_modified)
            if status == 200:
                feed, items = parse_feed(body)
                items.sort(key=lambda item: item["publishedTs"], reverse=True)
                items = items[: args.max]
                cache = {
                    "schemaVersion": SCHEMA_VERSION,
                    "url": args.url,
                    "fetchedTs": now,
                    "etag": headers.get("ETag", "") or headers.get("Etag", ""),
                    "lastModified": headers.get("Last-Modified", ""),
                    "feed": feed,
                    "items": items,
                }
                write_json("cache", "feed.json", cache)
                cache_matches = True
                source = "network"
            elif status == 304 and cache_matches:
                cache["fetchedTs"] = now
                write_json("cache", "feed.json", cache)
                source = "network"
            else:
                message = "Feed said not-modified but nothing is cached"
        except (Timeout, Terminated):
            raise
        except Exception as error:  # noqa: BLE001 - reported to the panel
            message = describe_error(error)

    if cache is None or not cache_matches:
        emit(error_payload(message or "No cached news yet", args.url, now))
        return 0 if not message else 1

    if source == "cache" and message:
        message = "Offline — " + message[0].lower() + message[1:]
    elif source == "cache" and args.offline:
        message = ""

    # Read-state bookkeeping. Ids unseen before this run are "new"; the first
    # run instead seeds everything as known and marks the older posts read.
    item_ids = [item["id"] for item in cache["items"]]
    known = set(state["known"])
    new_ids = []
    if not state["initialized"] and not known:
        cutoff = now - FIRST_RUN_UNREAD_DAYS * 86400
        read = set(state["read"])
        for item in cache["items"]:
            if item["publishedTs"] and item["publishedTs"] < cutoff:
                read.add(item["id"])
        state["read"] = list(read)
    else:
        new_ids = [item_id for item_id in item_ids if item_id not in known]
    state["known"] = list(dict.fromkeys(state["known"] + item_ids))
    save_state(state, item_ids)

    emit(build_payload(state, cache, source, message, new_ids, now))
    return 0


def _emit_from_cache(state, message=""):
    now = int(time.time())
    cache = load_cache()
    if cache is None:
        emit(error_payload("No cached news yet", "", now))
        return 1
    save_state(state, [item["id"] for item in cache["items"]])
    emit(build_payload(state, cache, "cache", message, [], now))
    return 0


def _mark_ids(values):
    """The ids a mark command may touch: bounded in count and shape, and only
    ids the cache actually holds, so the state file cannot be grown with junk."""
    if len(values) > MAX_MARK_IDS:
        return None
    cache = load_cache()
    known = {item["id"] for item in cache["items"]} if cache else set()
    ids = []
    for value in values:
        cleaned = clean_id(value)
        if not cleaned:
            return None
        if cleaned in known:
            ids.append(cleaned)
    return ids


def cmd_mark_read(args):
    ids = _mark_ids(args.ids)
    if ids is None:
        emit(error_payload("Invalid post id", "", int(time.time())))
        return 2
    state = load_state()
    state["read"] = list(dict.fromkeys(state["read"] + ids))
    return _emit_from_cache(state)


def cmd_mark_unread(args):
    ids = _mark_ids(args.ids)
    if ids is None:
        emit(error_payload("Invalid post id", "", int(time.time())))
        return 2
    state = load_state()
    wanted = set(ids)
    state["read"] = [item_id for item_id in state["read"] if item_id not in wanted]
    return _emit_from_cache(state)


def cmd_mark_all_read(args):
    state = load_state()
    cache = load_cache()
    if cache is not None:
        state["read"] = list(dict.fromkeys(state["read"] + [item["id"] for item in cache["items"]]))
    return _emit_from_cache(state)


def main(argv):
    parser = argparse.ArgumentParser(prog="omapress", description=__doc__.split("\n\n")[0])
    parser.add_argument("--budget", type=float, default=DEFAULT_BUDGET,
                        help="absolute deadline for the whole run in seconds (%d-%d)" % (MIN_BUDGET, MAX_BUDGET))
    # Lets the caller signal the helper and anything it started as one group.
    # Off by default so a terminal user's Ctrl+C keeps working as usual.
    parser.add_argument("--own-process-group", action="store_true", help=argparse.SUPPRESS)
    sub = parser.add_subparsers(dest="command")

    fetch = sub.add_parser("fetch", help="fetch the feed and print it as JSON")
    fetch.add_argument("--url", default=DEFAULT_URL, help="https feed URL; also the cache key")
    fetch.add_argument("--max", type=int, default=DEFAULT_MAX_ITEMS)
    fetch.add_argument("--offline", action="store_true", help="serve the cache without touching the network")
    fetch.add_argument("--source", default="", help="read the feed from this local file instead of the network")
    fetch.set_defaults(func=cmd_fetch)

    mark_read = sub.add_parser("mark-read", help="mark posts read by id")
    mark_read.add_argument("ids", nargs="+")
    mark_read.set_defaults(func=cmd_mark_read)

    mark_unread = sub.add_parser("mark-unread", help="mark posts unread by id")
    mark_unread.add_argument("ids", nargs="+")
    mark_unread.set_defaults(func=cmd_mark_unread)

    mark_all = sub.add_parser("mark-all-read", help="mark every cached post read")
    mark_all.set_defaults(func=cmd_mark_all_read)

    args = parser.parse_args(argv)
    if not args.command:
        parser.print_help()
        return 2
    if getattr(args, "max", None) is not None:
        args.max = max(1, min(MAX_ITEMS, args.max))

    global DEADLINE
    budget = max(MIN_BUDGET, min(MAX_BUDGET, float(args.budget) if args.budget == args.budget else DEFAULT_BUDGET))
    DEADLINE = time.monotonic() + budget
    if args.own_process_group:
        try:
            os.setpgid(0, 0)
        except OSError:
            pass
    signal.signal(signal.SIGTERM, on_terminate)
    signal.signal(signal.SIGALRM, on_alarm)
    # The alarm is the backstop for code that never consults remaining(),
    # such as DNS resolution inside getaddrinfo.
    signal.alarm(int(budget) + 5)
    try:
        return args.func(args)
    except StateError as error:
        emit(error_payload("Cannot use the plugin's state directory: %s" % error, getattr(args, "url", ""), int(time.time())))
        return 1
    except Timeout:
        emit(error_payload("Feed fetch ran out of time", getattr(args, "url", ""), int(time.time())))
        return 1
    except Terminated:
        return 143
    finally:
        signal.alarm(0)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
